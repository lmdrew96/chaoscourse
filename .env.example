# Convex — provisioned via `npx convex dev`
CONVEX_URL=
CONVEX_DEPLOYMENT=

# Anthropic API — used by the syllabus parser
ANTHROPIC_API_KEY=

# Clerk — used for OAuth 2.0 PKCE flow
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public-facing base URL — used for OAuth issuer + WWW-Authenticate metadata
# Leave unset on Vercel (VERCEL_URL is auto-populated); set for local dev or custom domain.
CHAOSCOURSE_BASE_URL=
